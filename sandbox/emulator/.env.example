# MuMu Player manager path (Windows only, auto-detected on macOS/Linux)
# MUMU_MANAGER_PATH=C:\\Program Files\\Netease\\MuMu\\nx_main\\MuMuManager.exe

# Server
# MUMU_HOST=0.0.0.0
# MUMU_PORT=8000

# SICO_SANDBOX_SERVICE_TOKEN is read from the repository-root .env by default.
# Set it here only when running this service from a standalone checkout.

# CORS is disabled when empty. Backend service-to-service calls do not need it.
CORS_ORIGINS=
